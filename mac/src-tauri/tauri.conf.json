{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Unblent",
  "version": "0.1.0",
  "identifier": "com.unblent.app",
  "build": {
    "frontendDist": "../loading"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "shortDescription": "A reader for ePub books, with notes and a journal",
    "copyright": "Copyright (c) 2026 Maciek Kreft",
    "license": "MIT",
    "homepage": "https://unblent.com",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "resources": {
      "../build/dist/unblent-server/": "unblent-server/"
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "dmg": {
        "windowSize": { "width": 540, "height": 380 },
        "appPosition": { "x": 140, "y": 180 },
        "applicationFolderPosition": { "x": 400, "y": 180 }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE0OUM2RUUzMDBGQTBBODYKUldTR0N2b0E0MjZjRk02cVBKSXZNdFFnb1o2RDhseFoyVTBETjhDZ1lvVnZibVVCOXA4b0UzUFYK",
      "endpoints": [
        "https://github.com/maciekkreft/unblent/releases/latest/download/latest.json"
      ]
    }
  }
}

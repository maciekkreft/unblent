{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A choice point is gone.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "day": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  },
  "required": [
    "id",
    "day"
  ],
  "additionalProperties": false
}

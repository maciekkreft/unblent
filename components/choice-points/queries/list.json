{
  "payload": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "The day whose choice points are wanted; every day's when left out.",
    "type": "object",
    "properties": {
      "day": {
        "type": "string",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
      }
    },
    "additionalProperties": false
  },
  "reply": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "The choice points, oldest first, each whole as choice-point.changed carries it.",
    "type": "object",
    "properties": {
      "choicePoints": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
            },
            "day": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "description": "The journal day the choice point is kept with, as its date; it never changes."
            },
            "situation": {
              "type": "string",
              "description": "The situation: what happened, where and with whom."
            },
            "thoughts": {
              "type": "string",
              "description": "The thoughts and feelings the situation brought."
            },
            "away": {
              "type": "string",
              "description": "What the user did or would do when hooked: a move away from what matters."
            },
            "towards": {
              "type": "string",
              "description": "What the user did or would do when unhooked: a move towards what matters."
            },
            "createdAt": {
              "type": "string",
              "format": "date-time",
              "description": "When the choice point was added."
            },
            "version": {
              "type": "integer",
              "minimum": 1
            },
            "pending": {
              "type": "boolean",
              "description": "A change the server has not acknowledged yet (5)."
            },
            "removing": {
              "type": "boolean",
              "description": "The choice point waits out its undo window (removal.started)."
            }
          },
          "required": [
            "id",
            "day",
            "situation",
            "thoughts",
            "away",
            "towards",
            "createdAt",
            "version",
            "pending",
            "removing"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "choicePoints"
    ],
    "additionalProperties": false
  },
  "supersededBy": [
    "choice-point.changed",
    "choice-point.deleted"
  ]
}

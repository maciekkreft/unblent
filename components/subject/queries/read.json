{
  "payload": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "read takes no arguments.",
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "reply": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "The subject — the thing shown by the view of that sort last in front on the stage (3.1), a kind, an id, a title and the view that shows it — or null when nothing is open.",
    "type": "object",
    "properties": {
      "subject": {
        "oneOf": [
          { "type": "null" },
          {
            "type": "object",
            "properties": {
              "kind": { "type": "string", "minLength": 1 },
              "id": { "type": "string", "minLength": 1 },
              "title": { "type": "string" },
              "view": { "type": "string", "minLength": 1 }
            },
            "required": ["kind", "id", "title"],
            "additionalProperties": false
          }
        ]
      }
    },
    "required": ["subject"],
    "additionalProperties": false
  },
  "supersededBy": ["subject.changed"]
}

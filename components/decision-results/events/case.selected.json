{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The user picked a case, or New case (a fresh id no case has yet): it becomes the open case of its project.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "project": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    }
  },
  "required": [
    "id",
    "project"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The user copied a link to a highlight (Copy link, or y with Vim keys); an editor puts `text` in Vim's unnamed register, so p pastes it.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$", "description": "The highlight's note id." },
    "text": { "type": "string", "minLength": 1, "description": "The stored link, [label](note:<id>)." }
  },
  "required": ["id", "text"],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The user renamed a chat by hand in the list. An empty title gives the chat back its first message's first line.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "title": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "title"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The user paused: the whole draft, and the version it was based on (null for a note this editor just minted). about, when present, replaces the note's links (12); absent leaves them (a new note carries one link to the subject).",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
    "title": { "type": "string" },
    "body": { "type": "string" },
    "baseVersion": { "type": ["integer", "null"], "minimum": 1 },
    "about": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "id": { "type": "string", "minLength": 1 },
          "chapter": { "type": "string", "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2}|[a-z0-9]+(-[a-z0-9]+)*)$", "description": "Which chapter of the linked book the thing was made in. For the Journal it is the day, as YYYY-MM-DD. For a book it is the chapter's title in lowercase letters a to z and digits 0 to 9, an accented letter written without its accent (ś as s, ł as l), each run of other characters made one hyphen and none at either end, so it survives the chapters being renumbered or the book re-imported. Absent when the link is to the whole book, as on every link made before chapters were recorded." },
          "chapterTitle": { "type": "string", "minLength": 1, "description": "The chapter's title as it read when the link was made, for display, so it still shows after the book changes or is gone; present exactly when chapter is." },
          "place": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "chapter": { "type": "integer", "minimum": 0 },
                  "contentVersion": { "type": "integer", "minimum": 0 },
                  "start": {
                    "type": "object",
                    "properties": {
                      "block": { "type": "integer", "minimum": 0 },
                      "offset": { "type": "integer", "minimum": 0 }
                    },
                    "required": ["block", "offset"],
                    "additionalProperties": false
                  },
                  "end": {
                    "type": "object",
                    "properties": {
                      "block": { "type": "integer", "minimum": 0 },
                      "offset": { "type": "integer", "minimum": 0 }
                    },
                    "required": ["block", "offset"],
                    "additionalProperties": false
                  }
                },
                "required": ["chapter", "contentVersion", "start", "end"],
                "additionalProperties": false
              }
            ]
          },
          "quote": {
            "type": "object",
            "properties": {
              "exact": { "type": "string" },
              "prefix": { "type": "string" },
              "suffix": { "type": "string" }
            },
            "required": ["exact", "prefix", "suffix"],
            "additionalProperties": false
          }
        },
        "required": ["kind", "id"],
        "dependentRequired": { "chapter": ["chapterTitle"], "chapterTitle": ["chapter"] },
        "additionalProperties": false
      }
    }
  },
  "required": ["id", "title", "body", "baseVersion"],
  "additionalProperties": false
}

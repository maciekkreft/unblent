{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Jev's answers changed: the latest answers for every case and tool, and the latest run, every time anything changed.",
  "type": "object",
  "properties": {
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "The latest answers for one case and one tool.",
        "properties": {
          "case": {
            "type": "string",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
          },
          "rubric": {
            "type": "string",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
          },
          "at": {
            "type": "integer",
            "description": "When Jev answered, ms since the epoch."
          },
          "answers": {
            "type": "array",
            "items": {
              "type": "object",
              "description": "Jev's answer to one question.",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                  "description": "The question's id."
                },
                "p": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "For a yesno question the probability of yes; for a pick question the probability of the pick."
                },
                "choice": {
                  "type": "string",
                  "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                  "description": "For a pick question, the option Jev picked."
                },
                "probabilities": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                      },
                      "p": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    },
                    "required": [
                      "id",
                      "p"
                    ],
                    "additionalProperties": false
                  },
                  "description": "For a pick question, the probability of every option, by option id."
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "For a pick question, how sure Jev is, from how its probabilities are spread."
                }
              },
              "required": [
                "id",
                "p"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "case",
          "rubric",
          "at",
          "answers"
        ],
        "additionalProperties": false
      }
    },
    "run": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "project": {
              "type": "string",
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
            },
            "cases": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
              },
              "description": "The cases the run judges, in order."
            },
            "done": {
              "type": "integer",
              "minimum": 0,
              "description": "How many of them are judged."
            },
            "running": {
              "type": "boolean"
            },
            "error": {
              "enum": [
                "signed-out",
                "no-key",
                "bad-key",
                "rate-limited",
                "overloaded",
                "invalid",
                "busy",
                "unavailable",
                null
              ],
              "description": "Why the run stopped early, or null."
            }
          },
          "required": [
            "project",
            "cases",
            "done",
            "running",
            "error"
          ],
          "additionalProperties": false
        }
      ],
      "description": "The latest Judge or Judge all and how far it got; null before the first."
    }
  },
  "required": [
    "decisions",
    "run"
  ],
  "additionalProperties": false
}

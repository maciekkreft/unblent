{
  "payload": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "The day whose choice points' checks are wanted; only the settings when left out.",
    "type": "object",
    "properties": {
      "day": {
        "type": "string",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "reply": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "The settings, whole as checks.changed carries them, and what Jev answered about each line of the day's choice points.",
    "type": "object",
    "properties": {
      "settings": {
        "type": "object",
        "description": "Which evaluator checks each box of a choice point, and how its answers are shown, for all four boxes.",
        "properties": {
          "away": {
            "type": "object",
            "description": "The away box's settings, as checks.edited carries one box.",
            "properties": {
              "evaluator": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                "description": "The evaluator that checks each line of the box; null for none, so the box is not checked."
              },
              "questions": {
                "type": "array",
                "description": "How each of the evaluator's questions is shown, in the evaluator's order; a question left out is not shown.",
                "items": {
                  "type": "object",
                  "description": "How one of the evaluator's questions is shown.",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
                      "description": "The evaluator's question this setting is for."
                    },
                    "show": {
                      "type": "boolean",
                      "description": "Whether the question's answer is shown as a mark next to the line."
                    },
                    "expect": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "pattern": "^([0-9A-HJKMNP-TV-Z]{26}|yes|no)$",
                      "description": "The answer expected: green when Jev gives it, red when not; null when no answer is expected, so the mark has no colour. An option id, or yes or no for a yes / no question."
                    },
                    "when": {
                      "description": "Show the mark only when another question of the box got this answer; null for always.",
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "question": {
                              "type": "string",
                              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                            },
                            "option": {
                              "type": "string",
                              "pattern": "^([0-9A-HJKMNP-TV-Z]{26}|yes|no)$",
                              "description": "An answer of the question: the id of a pick question's option, or yes or no for a yes / no question."
                            }
                          },
                          "required": [
                            "question",
                            "option"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "icons": {
                      "type": "object",
                      "description": "The icon each answer gets, by option id (or yes / no). auto: a check when the answer is the expected one and a warning when not; none: no icon. An answer left out is auto.",
                      "additionalProperties": {
                        "enum": [
                          "auto",
                          "check",
                          "warning",
                          "person-simple-walk",
                          "brain",
                          "none"
                        ]
                      }
                    }
                  },
                  "required": [
                    "id",
                    "show",
                    "expect",
                    "when",
                    "icons"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "evaluator",
              "questions"
            ],
            "additionalProperties": false
          },
          "towards": {
            "type": "object",

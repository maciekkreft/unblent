{
  "payload": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "read takes no arguments.",
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "reply": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Every gauge, with its last reading.",
    "type": "object",
    "properties": {
      "gauges": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
            },
            "name": {
              "type": "string"
            },
            "question": {
              "type": "string",
              "description": "The headline question, asked directly and not counted in the score."
            },
            "rule": {
              "enum": [
                "adds",
                "holds"
              ],
              "description": "adds: the score is the average of the answers; holds: the geometric mean."
            },
            "questions": {
              "type": "array",
              "items": {
                "type": "object",
                "description": "One yes/no question the tool asks.",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                  },
                  "text": {
                    "type": "string",
                    "description": "The question, as Jev is asked it."
                  },
                  "yes": {
                    "type": "string",
                    "description": "When the answer is yes; empty for no criteria."
                  },
                  "no": {
                    "type": "string",
                    "description": "When the answer is no; empty for no criteria."
                  },
                  "label": {
                    "type": "string",
                    "description": "A short name for the question, shown on the card; optional."
                  }
                },
                "required": [
                  "id",
                  "text",
                  "yes",
                  "no"
                ],
                "additionalProperties": false
              }
            },
            "reading": {
              "type": [
                "object",
                "null"
              ],
              "description": "The last reading, or null before any.",
              "properties": {
                "at": {
                  "type": "integer",
                  "description": "When Jev answered, ms since the epoch."
                },
                "answers": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                      },
                      "p": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    },
                    "required": [
                      "id",
                      "p"
                    ],
                    "additionalProperties": false
                  }
                },
                "direct": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1,
                  "description": "The headline question's answer, null when it was not asked."
                },
                "score": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1
                },
                "band": {
                  "enum": [
                    "high",
                    "mixed",
                    "low",
                    null
                  ]
                }
              },
              "required": [
                "at",
                "answers",
                "direct",
                "score",
                "band"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "id",
            "name",
            "question",
            "rule",
            "questions",
            "reading"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "gauges"
    ],
    "additionalProperties": false
  },
  "supersededBy": [
    "gauge.changed"
  ]
}

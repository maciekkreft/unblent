{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The user picked a journal detector, or New detector (a fresh id no detector has yet) in the named project: the editor that follows opens it.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "project": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    }
  },
  "required": [
    "id",
    "project"
  ],
  "additionalProperties": false
}

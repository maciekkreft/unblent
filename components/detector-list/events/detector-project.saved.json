{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The user made a new journal project (an id no project has yet) or renamed one.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "name": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "name"
  ],
  "additionalProperties": false
}

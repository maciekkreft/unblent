{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The user ticked or unticked a journal detector: whether it reads the writing while its project is on.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "on": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "on"
  ],
  "additionalProperties": false
}

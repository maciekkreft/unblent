{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Jev answered a Score: the raw answers, one reading per gauge that was asked. answers[].id is the question id; direct is the headline's answer, null when the headline was empty and not asked.",
  "type": "object",
  "properties": {
    "readings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
          },
          "answers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                },
                "p": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "id",
                "p"
              ],
              "additionalProperties": false
            }
          },
          "direct": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "id",
          "answers",
          "direct"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "readings"
  ],
  "additionalProperties": false
}

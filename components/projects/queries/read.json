{
  "payload": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "read takes no arguments.",
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "reply": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Every project and the current one.",
    "type": "object",
    "properties": {
      "projects": {
        "type": "array",
        "items": {
          "type": "object",
          "description": "One project.",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
            },
            "name": {
              "type": "string"
            },
            "removing": {
              "type": "boolean",
              "description": "True while its deletion can still be undone; it still exists until then."
            }
          },
          "required": [
            "id",
            "name",
            "removing"
          ],
          "additionalProperties": false
        },
        "minItems": 1
      },
      "current": {
        "type": "string",
        "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
      }
    },
    "required": [
      "projects",
      "current"
    ],
    "additionalProperties": false
  },
  "supersededBy": [
    "project.changed"
  ]
}

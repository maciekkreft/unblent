{
  "payload": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "read names one chat by id.",
    "type": "object",
    "properties": {
      "id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" }
    },
    "required": ["id"],
    "additionalProperties": false
  },
  "reply": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "The whole chat, or an honest error when there is none by that id or the server cannot be reached. A tool result rides as its `size`, not its `content` (4.3): `conversations` keeps the content and sends only its length.",
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "conversation": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
              "title": { "type": "string" },
              "about": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "kind": { "type": "string", "minLength": 1 },
                    "id": { "type": "string", "minLength": 1 },
                    "chapter": { "type": "string", "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2}|[a-z0-9]+(-[a-z0-9]+)*)$", "description": "Which chapter of the linked book the thing was made in. For the Journal it is the day, as YYYY-MM-DD. For a book it is the chapter's title in lowercase letters a to z and digits 0 to 9, an accented letter written without its accent (ś as s, ł as l), each run of other characters made one hyphen and none at either end, so it survives the chapters being renumbered or the book re-imported. Absent when the link is to the whole book, as on every link made before chapters were recorded." },
                    "chapterTitle": { "type": "string", "minLength": 1, "description": "The chapter's title as it read when the link was made, for display, so it still shows after the book changes or is gone; present exactly when chapter is." }
                  },
                  "required": ["kind", "id"],
                  "dependentRequired": { "chapter": ["chapterTitle"], "chapterTitle": ["chapter"] },
                  "additionalProperties": false
                }
              },
              "start": { "type": "string" },
              "turns": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
                        "role": { "const": "user" },
                        "text": { "type": "string" },
                        "at": { "type": "integer" },
                        "results": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "callId": { "type": "string" },
                              "content": { "type": "string" },
                              "size": { "type": "integer" },
                              "isError": { "type": "boolean" },
                              "name": { "type": "string", "minLength": 1, "description": "What the lookup read, named: the reply field its query's tool entry points at with `name` (7.2), such as a note's or chapter's title. Computed from the content when announced; absent for an error, a listing, or a reply without it." },
                              "excerpt": { "type": "string", "minLength": 1, "description": "The first 30 words of the reply field the tool entry points at with `excerpt` (7.2), split on runs of whitespace and joined by one space. Absent when there is none." }
                            },
                            "required": ["callId"],
                            "additionalProperties": false
                          }
                        },
                        "marks": {
                          "description": "The comments on the answer before this turn that were sent with it, read only from then on.",
                          "type": "array",
                          "items": { "$ref": "#/$defs/mark" }
                        }
                      },
                      "required": ["id", "role", "text"],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
                        "role": { "const": "assistant" },
                        "text": { "type": "string" },
                        "at": { "type": "integer" },
                        "thinking": { "type": "string" },
                        "status": { "enum": ["pending", "waiting", "done", "stopped", "failed"] },
                        "calls": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": { "type": "string" },
                              "target": { "type": "string" },
                              "name": { "type": "string" },
                              "payload": { "type": "object" },
                              "label": { "type": "string" },
                              "invalid": { "type": "string" }
                            },
                            "required": ["id", "target", "name", "payload", "label"],
                            "additionalProperties": false
                          }
                        },
                        "raw": { "type": "array" },
                        "provider": { "type": "string" },
                        "model": { "type": "string" },
                        "usage": { "type": "object" },
                        "error": { "type": "string" }
                      },
                      "required": ["id", "role", "text", "status"],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "pending": { "type": "boolean" },
              "updatedAt": { "type": "integer" },
              "marks": { "$ref": "#/$defs/unsent" },
              "highlights": { "description": "The highlights on the chat's answers; absent when there are none.", "type": "array", "items": { "$ref": "#/$defs/highlight" } }
            },
            "required": ["id", "title", "about", "start", "turns", "pending", "updatedAt"],
            "additionalProperties": false
          }
        },
        "required": ["conversation"],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": { "error": { "const": "not-found" } },
        "required": ["error"],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": { "error": { "const": "unavailable" } },
        "required": ["error"],
        "additionalProperties": false
      }
    ],
    "$defs": {
      "highlight": {
        "description": "One highlight on a passage of an answer, the user's own and never sent to the model: `start` and `end` are character positions in the answer's text, `quote` is that passage.",
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
          "answerId": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
          "start": { "type": "integer", "minimum": 0 },
          "end": { "type": "integer", "minimum": 0 },
          "quote": { "type": "string" }
        },
        "required": ["id", "answerId", "start", "end", "quote"],
        "additionalProperties": false
      },
      "mark": {
        "description": "One comment on a passage of an answer: `start` and `end` are character positions in the answer's text, `quote` is that passage.",
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
          "start": { "type": "integer", "minimum": 0 },
          "end": { "type": "integer", "minimum": 0 },
          "quote": { "type": "string" },
          "comment": { "type": "string" }
        },
        "required": ["id", "start", "end", "quote", "comment"],
        "additionalProperties": false
      },
      "unsent": {
        "description": "The comments on the last finished answer not yet sent, kept with the chat until the next message carries them; absent when there are none.",
        "type": "object",
        "properties": {
          "answerId": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
          "marks": { "type": "array", "items": { "$ref": "#/$defs/mark" } }
        },
        "required": ["answerId", "marks"],
        "additionalProperties": false
      }
    }
  },
  "supersededBy": ["conversation.changed", "conversation.deleted"]
}

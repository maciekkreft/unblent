{
  "payload": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "list takes nothing; it returns every chat's heading, newest first.",
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "reply": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Each chat's heading (12): id, title, the first line of its latest answer (subtitle), what it is linked to, when it changed, and whether it still has a finished turn the server has not confirmed. Or an honest error when the server cannot be reached; exactly one of `conversations` or `error` is present.",
    "type": "object",
    "properties": {
      "conversations": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
            "title": { "type": "string" },
            "about": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "kind": { "type": "string", "minLength": 1 },
                  "id": { "type": "string", "minLength": 1 }
                },
                "required": ["kind", "id"],
                "additionalProperties": false
              }
            },
            "updatedAt": { "type": "integer" },
            "pending": { "type": "boolean" },
            "subtitle": { "type": "string", "description": "The first line of the latest answer that has text, as plain text, at most 120 characters; \"\" when there is none." }
          },
          "required": ["id", "title", "about", "updatedAt", "pending"],
          "additionalProperties": false
        }
      },
      "error": { "const": "unavailable" }
    },
    "additionalProperties": false
  },
  "supersededBy": ["conversation.changed", "conversation.deleted"]
}

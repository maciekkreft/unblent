{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The user wrote in the open day: its whole text. A new id starts today's entry.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "text": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "text"
  ],
  "additionalProperties": false
}

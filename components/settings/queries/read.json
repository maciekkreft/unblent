{
  "payload": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "read takes no arguments.",
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "reply": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "The user's page preferences.",
    "type": "object",
    "properties": {
      "nav": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "path": { "type": "string" },
            "hidden": { "type": "boolean" }
          },
          "required": ["path", "hidden"],
          "additionalProperties": false
        }
      },
      "viewportSwitchHidden": { "type": "boolean" },
      "layoutSwitchHidden": { "type": "boolean" },
      "arranging": { "type": "boolean" },
      "editors": {
        "type": "object",
        "additionalProperties": { "type": "string" }
      },
      "profile": {
        "enum": ["product", "workshop"],
        "description": "The active profile whose preferences these are (§12)."
      }
    },
    "required": ["nav", "viewportSwitchHidden", "layoutSwitchHidden", "arranging", "editors"],
    "additionalProperties": false
  },
  "supersededBy": ["settings.changed"]
}

{
  "payload": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "read takes no arguments.",
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "reply": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "The user's page preferences.",
    "type": "object",
    "properties": {
      "nav": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "path": { "type": "string" },
            "hidden": { "type": "boolean" }
          },
          "required": ["path", "hidden"],
          "additionalProperties": false
        }
      },
      "viewportSwitchHidden": { "type": "boolean" },
      "layoutSwitchHidden": { "type": "boolean" },
      "arranging": { "type": "boolean" },
      "vimKeys": { "type": "boolean", "description": "Vim keys on in every editor that has them; missing means off." },
      "keepOpen": { "type": "boolean", "description": "The open note and the open chat stay when the stage changes; missing means off, so they follow the stage." },
      "usageCounting": { "type": "boolean", "description": "This device counts which features are used and for how long, and sends those totals to the account; missing means off." },
      "editors": {
        "type": "object",
        "additionalProperties": { "type": "string" }
      },
      "profile": {
        "enum": ["product", "workshop"],
        "description": "The active profile whose preferences these are (§12)."
      }
    },
    "required": ["nav", "viewportSwitchHidden", "layoutSwitchHidden", "arranging", "editors"],
    "additionalProperties": false
  },
  "supersededBy": ["settings.changed"]
}

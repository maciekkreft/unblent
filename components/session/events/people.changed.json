{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The accounts Administration lists changed after one of the admin's gestures; the whole list, as session: people answers it (4.3).",
  "type": "object",
  "properties": {
    "people": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "guest": {
            "type": "boolean"
          },
          "admin": {
            "type": "boolean"
          },
          "firstSeen": {
            "type": "integer",
            "minimum": 0,
            "description": "Milliseconds since the epoch."
          },
          "lastSeen": {
            "type": "integer",
            "minimum": 0,
            "description": "Milliseconds since the epoch."
          },
          "country": {
            "type": "string",
            "description": "Two-letter country code from Cloudflare's visitor location headers; empty when unknown."
          },
          "city": {
            "type": "string",
            "description": "Empty when unknown."
          },
          "browser": {
            "type": "string"
          },
          "system": {
            "type": "string"
          },
          "device": {
            "enum": [
              "phone",
              "desk"
            ]
          },
          "space": {
            "type": "integer",
            "minimum": 0,
            "description": "Bytes the account's files take, for display only."
          }
        },
        "required": [
          "userId",
          "name",
          "guest",
          "admin",
          "firstSeen",
          "lastSeen",
          "space"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "people"
  ],
  "additionalProperties": false
}

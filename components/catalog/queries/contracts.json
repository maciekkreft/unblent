{
  "payload": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "contracts takes no arguments.",
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "reply": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "The event, query and command vocabulary, pivoted from every component's schema files, or an honest error.",
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "owner": { "type": "string" },
                "schema": { "type": "object" },
                "consumers": { "type": "array", "items": { "type": "string" } }
              },
              "required": ["name", "owner", "schema", "consumers"],
              "additionalProperties": false
            }
          },
          "queries": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "target": { "type": "string" },
                "name": { "type": "string" },
                "payload": { "type": "object" },
                "reply": { "type": "object" },
                "supersededBy": { "type": "array", "items": { "type": "string" } },
                "askers": { "type": "array", "items": { "type": "string" } },
                "tool": {
                  "type": "object",
                  "properties": {
                    "description": { "type": "string" },
                    "label": { "type": "string" },
                    "name": { "type": "string", "description": "A JSON pointer (RFC 6901) into the reply to the string naming what was read (7.2)." },
                    "excerpt": { "type": "string", "description": "A JSON pointer (RFC 6901) into the reply to text whose first 30 words describe what was read (7.2)." },
                    "switch": { "type": "boolean", "description": "false: Settings shows no switch for the tool and the chat always offers it, because its owner decides what it covers (7.2)." },
                    "title": { "type": "string", "description": "The tool's name in Settings, under What the chat may read (7.2)." },
                    "group": { "type": "string", "description": "The heading Settings lists the tool under (7.2)." },
                    "order": { "type": "number", "description": "Places the tool within its group in Settings (7.2)." },
                    "items": { "type": "string", "description": "A JSON pointer (RFC 6901) into the reply to the array of entries a listing returns (7.2)." },
                    "itemName": { "type": "string", "description": "A JSON pointer (RFC 6901), read inside each entry, to the string that names it (7.2)." },
                    "total": { "type": "string", "description": "A JSON pointer (RFC 6901) into the reply to the number of all entries that match (7.2)." },
                    "opens": { "type": "string", "description": "The kind of thing an entry's id, or the one thing read, names, so the chat can open it (7.2)." }
                  },
                  "required": ["description", "label"],
                  "additionalProperties": false
                }
              },
              "required": ["target", "name", "payload", "reply", "askers"],
              "additionalProperties": false
            }
          },
          "commands": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "target": { "type": "string" },
                "name": { "type": "string" },
                "payload": { "type": "object" },
                "senders": { "type": "array", "items": { "type": "string" } }
              },
              "required": ["target", "name", "payload"],
              "additionalProperties": false
            }
          }
        },
        "required": ["events", "queries", "commands"],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": { "error": { "const": "unavailable" } },
        "required": ["error"],
        "additionalProperties": false
      }
    ]
  },
  "supersededBy": []
}

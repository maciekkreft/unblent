{
  "payload": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "read takes nothing; it returns the account's language-model picture.",
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "reply": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "The account's picture (7.7): the chosen provider, model, effort and cache lifetime, and the choices offered. Never a key.",
    "type": "object",
    "properties": {
      "signedIn": { "type": "boolean" },
      "provider": { "type": "string" },
      "providers": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "label": { "type": "string" },
            "keySet": { "type": "boolean" },
            "needsKey": { "type": "boolean" }
          },
          "required": ["id", "label", "keySet", "needsKey"],
          "additionalProperties": false
        }
      },
      "model": { "type": "string" },
      "models": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "label": { "type": "string" }
          },
          "required": ["id", "label"],
          "additionalProperties": false
        }
      },
      "effort": { "type": "string" },
      "efforts": { "type": "array", "items": { "type": "string" } },
      "ttl": { "type": "string" },
      "jev": {
        "type": "object",
        "description": "Whether the account has saved its own Jev key, which llm: decide uses. Never the key.",
        "properties": {
          "keySet": { "type": "boolean" }
        },
        "required": ["keySet"],
        "additionalProperties": false
      }
    },
    "required": ["signedIn", "provider", "providers", "model", "models", "effort", "efforts", "ttl"],
    "additionalProperties": false
  },
  "supersededBy": ["llm.changed"]
}

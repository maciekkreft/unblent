{
  "payload": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Ask Jev (typesafe.ai's System One model) yes/no questions about one state, all in one request. Each question's yes and no are its criteria; an empty or missing one leaves the criteria out.",
    "type": "object",
    "properties": {
      "state": { "type": "object", "description": "What the questions are about, any JSON object." },
      "questions": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "properties": {
            "id": { "type": "string", "description": "The asker's own id; the answer comes back under it." },
            "instructions": { "type": "string" },
            "yes": { "type": "string" },
            "no": { "type": "string" }
          },
          "required": ["id", "instructions"],
          "additionalProperties": false
        }
      }
    },
    "required": ["state", "questions"],
    "additionalProperties": false
  },
  "reply": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Jev's answers, each the probability the answer is yes, with the request's input tokens and time; or an error.",
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "answers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "p": { "type": "number", "minimum": 0, "maximum": 1 }
              },
              "required": ["id", "p"],
              "additionalProperties": false
            }
          },
          "inputTokens": { "type": "integer", "minimum": 0 },
          "ms": { "type": "integer", "minimum": 0 }
        },
        "required": ["answers", "inputTokens", "ms"],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "error": { "enum": ["signed-out", "no-key", "bad-key", "rate-limited", "overloaded", "invalid", "busy", "unavailable"] }
        },
        "required": ["error"],
        "additionalProperties": false
      }
    ]
  },
  "supersededBy": []
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The account's language-model picture changed (7.7): who is signed in, the chosen provider, model, thinking effort and cache lifetime, and the choices offered. Never a key.",
  "type": "object",
  "properties": {
    "signedIn": { "type": "boolean" },
    "provider": { "type": "string" },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "keySet": { "type": "boolean" },
          "needsKey": { "type": "boolean" }
        },
        "required": ["id", "label", "keySet", "needsKey"],
        "additionalProperties": false
      }
    },
    "model": { "type": "string" },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" }
        },
        "required": ["id", "label"],
        "additionalProperties": false
      }
    },
    "effort": { "type": "string" },
    "efforts": { "type": "array", "items": { "type": "string" } },
    "ttl": { "type": "string" },
    "jev": {
      "type": "object",
      "description": "Whether the account has saved its own Jev key, which llm: decide uses. Never the key.",
      "properties": {
        "keySet": { "type": "boolean" }
      },
      "required": ["keySet"],
      "additionalProperties": false
    },
    "freeUse": {
      "type": "object",
      "description": "Only for a guest (7.7): the share of the guest's own allowance left, whether the guest is blocked, and the providers no guest may use now because a limit for all guests is reached. Never an amount.",
      "properties": {
        "left": { "type": "number", "minimum": 0, "maximum": 1 },
        "blocked": { "type": "boolean" },
        "paused": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["left", "blocked", "paused"],
      "additionalProperties": false
    }
  },
  "required": ["signedIn", "provider", "providers", "model", "models", "effort", "efforts", "ttl"],
  "additionalProperties": false
}

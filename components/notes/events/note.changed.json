{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A note now looks like this: the whole note (4, third rule), pending until the server acknowledges it (5). about is the note's links (12), [] when none.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
    "title": { "type": "string" },
    "subtitle": { "type": "string" },
    "body": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "pending": { "type": "boolean" },
    "updatedAt": { "type": "integer" },
    "position": { "type": "string", "description": "The note's place in the list: a key that sorts by plain comparison, the list in ascending order (5)." },
    "about": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "id": { "type": "string", "minLength": 1 },
          "place": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "chapter": { "type": "integer", "minimum": 0 },
                  "contentVersion": { "type": "integer", "minimum": 0 },
                  "start": {
                    "type": "object",
                    "properties": {
                      "block": { "type": "integer", "minimum": 0 },
                      "offset": { "type": "integer", "minimum": 0 }
                    },
                    "required": ["block", "offset"],
                    "additionalProperties": false
                  },
                  "end": {
                    "type": "object",
                    "properties": {
                      "block": { "type": "integer", "minimum": 0 },
                      "offset": { "type": "integer", "minimum": 0 }
                    },
                    "required": ["block", "offset"],
                    "additionalProperties": false
                  }
                },
                "required": ["chapter", "contentVersion", "start", "end"],
                "additionalProperties": false
              }
            ]
          },
          "quote": {
            "type": "object",
            "properties": {
              "exact": { "type": "string" },
              "prefix": { "type": "string" },
              "suffix": { "type": "string" }
            },
            "required": ["exact", "prefix", "suffix"],
            "additionalProperties": false
          }
        },
        "required": ["kind", "id"],
        "additionalProperties": false
      }
    }
  },
  "required": ["id", "title", "body", "version", "pending", "updatedAt"],
  "additionalProperties": false
}

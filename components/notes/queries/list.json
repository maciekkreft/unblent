{
  "payload": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "list takes no arguments.",
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "reply": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Every note as id, title, subtitle, time and links, for a list. subtitle is the note's second non-empty line, derived from the body (never stored). about is the note's links (12), [] when none.",
    "type": "object",
    "properties": {
      "notes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
            "title": { "type": "string" },
            "subtitle": { "type": "string" },
            "updatedAt": { "type": "integer" },
            "position": { "type": "string", "description": "The note's place in the list: a key that sorts by plain comparison, the list in ascending order (5)." },
            "about": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "kind": { "type": "string", "minLength": 1 },
                  "id": { "type": "string", "minLength": 1 },
                  "chapter": { "type": "string", "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2}|[a-z0-9]+(-[a-z0-9]+)*)$", "description": "Which chapter of the linked book the thing was made in. For the Journal it is the day, as YYYY-MM-DD. For a book it is the chapter's title in lowercase letters a to z and digits 0 to 9, an accented letter written without its accent (ś as s, ł as l), each run of other characters made one hyphen and none at either end, so it survives the chapters being renumbered or the book re-imported. Absent when the link is to the whole book, as on every link made before chapters were recorded." },
                  "chapterTitle": { "type": "string", "minLength": 1, "description": "The chapter's title as it read when the link was made, for display, so it still shows after the book changes or is gone; present exactly when chapter is." },
                  "place": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "chapter": { "type": "integer", "minimum": 0 },
                          "contentVersion": { "type": "integer", "minimum": 0 },
                          "start": {
                            "type": "object",
                            "properties": {
                              "block": { "type": "integer", "minimum": 0 },
                              "offset": { "type": "integer", "minimum": 0 }
                            },
                            "required": ["block", "offset"],
                            "additionalProperties": false
                          },
                          "end": {
                            "type": "object",
                            "properties": {
                              "block": { "type": "integer", "minimum": 0 },
                              "offset": { "type": "integer", "minimum": 0 }
                            },
                            "required": ["block", "offset"],
                            "additionalProperties": false
                          }
                        },
                        "required": ["chapter", "contentVersion", "start", "end"],
                        "additionalProperties": false
                      }
                    ]
                  },
                  "quote": {
                    "type": "object",
                    "properties": {
                      "exact": { "type": "string" },
                      "prefix": { "type": "string" },
                      "suffix": { "type": "string" }
                    },
                    "required": ["exact", "prefix", "suffix"],
                    "additionalProperties": false
                  }
                },
                "required": ["kind", "id"],
                "dependentRequired": { "chapter": ["chapterTitle"], "chapterTitle": ["chapter"] },
                "additionalProperties": false
              }
            }
          },
          "required": ["id", "title", "updatedAt"],
          "additionalProperties": false
        }
      }
    },
    "required": ["notes"],
    "additionalProperties": false
  },
  "supersededBy": ["note.changed", "note.deleted"],
  "tool": {
    "description": "Lists every note and highlight the reader has written — title, a preview line, and what each is about. Their notes and highlights show what caught their attention, so they are worth reading when relevant. Each highlight is listed on its own here, but the reader sees all of a book's highlights as one note named Highlights. Gives the ids that reading a note needs. Takes no arguments.",
    "label": "Listing the notes"
  }
}

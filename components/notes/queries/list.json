{
  "payload": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "list takes no arguments.",
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "reply": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Every note as id, title, subtitle, time and links, for a list. subtitle is the note's second non-empty line, derived from the body (never stored). about is the note's links (12), [] when none.",
    "type": "object",
    "properties": {
      "notes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
            "title": { "type": "string" },
            "subtitle": { "type": "string" },
            "updatedAt": { "type": "integer" },
            "about": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "kind": { "type": "string", "minLength": 1 },
                  "id": { "type": "string", "minLength": 1 },
                  "place": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "chapter": { "type": "integer", "minimum": 0 },
                          "contentVersion": { "type": "integer", "minimum": 0 },
                          "start": {
                            "type": "object",
                            "properties": {
                              "block": { "type": "integer", "minimum": 0 },
                              "offset": { "type": "integer", "minimum": 0 }
                            },
                            "required": ["block", "offset"],
                            "additionalProperties": false
                          },
                          "end": {
                            "type": "object",
                            "properties": {
                              "block": { "type": "integer", "minimum": 0 },
                              "offset": { "type": "integer", "minimum": 0 }
                            },
                            "required": ["block", "offset"],
                            "additionalProperties": false
                          }
                        },
                        "required": ["chapter", "contentVersion", "start", "end"],
                        "additionalProperties": false
                      }
                    ]
                  },
                  "quote": {
                    "type": "object",
                    "properties": {
                      "exact": { "type": "string" },
                      "prefix": { "type": "string" },
                      "suffix": { "type": "string" }
                    },
                    "required": ["exact", "prefix", "suffix"],
                    "additionalProperties": false
                  }
                },
                "required": ["kind", "id"],
                "additionalProperties": false
              }
            }
          },
          "required": ["id", "title", "updatedAt"],
          "additionalProperties": false
        }
      }
    },
    "required": ["notes"],
    "additionalProperties": false
  },
  "supersededBy": ["note.changed", "note.deleted"]
}

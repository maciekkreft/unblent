{
  "payload": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "list takes no arguments.",
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "reply": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Every note as id, title, subtitle and time, for a list. subtitle is the note's second non-empty line, derived from the body (never stored).",
    "type": "object",
    "properties": {
      "notes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
            "title": { "type": "string" },
            "subtitle": { "type": "string" },
            "updatedAt": { "type": "integer" }
          },
          "required": ["id", "title", "updatedAt"],
          "additionalProperties": false
        }
      }
    },
    "required": ["notes"],
    "additionalProperties": false
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A book now looks like this: the whole row that rides the bus (4, third rule), pending until the server acknowledges a change (5). The chapters and images are files fetched by URL, not carried here; cover is such a URL or null.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
    "title": { "type": "string" },
    "author": { "type": "string" },
    "cover": { "type": ["string", "null"] },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": { "title": { "type": "string" }, "day": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "The journal day this chapter is, YYYY-MM-DD, as a journal day carries it; only on the written book." } },
        "required": ["title"],
        "additionalProperties": false
      }
    },
    "toc": { "type": "array", "items": { "$ref": "#/$defs/tocEntry" } },
    "position": { "$ref": "#/$defs/position" },
    "version": { "type": "integer", "minimum": 1 },
    "contentVersion": { "type": "integer", "minimum": 1 },
    "pending": { "type": "boolean" },
    "addedAt": { "type": "integer" },
    "updatedAt": { "type": "integer" },
    "written": { "type": "boolean", "description": "True only for the journal, the book the user writes, owned by journal; absent for an imported book." }
  },
  "required": ["id", "title", "author", "cover", "chapters", "toc", "position", "version", "contentVersion", "pending", "addedAt", "updatedAt"],
  "additionalProperties": false,
  "$defs": {
    "position": {
      "type": "object",
      "properties": {
        "chapter": { "type": "integer", "minimum": 0 },
        "block": { "type": "integer", "minimum": 0 }
      },
      "required": ["chapter", "block"],
      "additionalProperties": false
    },
    "tocEntry": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "chapter": { "type": "integer", "minimum": 0 },
        "block": { "type": "integer", "minimum": 0 },
        "children": { "type": "array", "items": { "$ref": "#/$defs/tocEntry" } }
      },
      "required": ["title", "chapter", "block", "children"],
      "additionalProperties": false
    }
  }
}

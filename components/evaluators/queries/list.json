{
  "payload": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "The book whose evaluators are wanted; every book's evaluators when left out.",
    "type": "object",
    "properties": {
      "book": {
        "type": "string",
        "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
      }
    },
    "additionalProperties": false
  },
  "reply": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "The evaluators, of the book asked for or of every book, oldest first, each whole as evaluator.changed carries it.",
    "type": "object",
    "properties": {
      "evaluators": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
            },
            "book": {
              "type": "string",
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
              "description": "The book the evaluator is kept with."
            },
            "name": {
              "type": "string"
            },
            "on": {
              "type": "boolean",
              "description": "Switched on or off."
            },
            "journal": {
              "type": "boolean",
              "description": "Listed in the journal's Evaluators as well as its own book's (\"Show in journal\"); false when absent."
            },
            "questions": {
              "type": "array",
              "items": {
                "type": "object",
                "description": "One question of the evaluator.",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                  },
                  "kind": {
                    "enum": [
                      "yesno",
                      "pick"
                    ],
                    "description": "yesno: a yes / no question. pick: one of the options is picked."
                  },
                  "text": {
                    "type": "string",
                    "description": "The question."
                  },
                  "yes": {
                    "type": "string",
                    "description": "What yes means, for a yesno question; empty for none."
                  },
                  "no": {
                    "type": "string",
                    "description": "What no means, for a yesno question; empty for none."
                  },
                  "options": {
                    "type": "array",
                    "description": "The options of a pick question; kept while the question is yesno, so switching back loses nothing.",
                    "items": {
                      "type": "object",
                      "description": "One option of a pick question.",
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
                        },
                        "name": {
                          "type": "string",
                          "description": "The option as the user sees it."
                        },
                        "description": {
                          "type": "string",
                          "description": "What the option means; empty for none."
                        },
                        "removing": {
                          "type": "boolean",
                          "description": "The option waits out its undo window (removal.started)."
                        }
                      },
                      "required": [
                        "id",
                        "name",
                        "description"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "removing": {
                    "type": "boolean",
                    "description": "The question waits out its undo window (removal.started)."
                  }
                },
                "required": [
                  "id",
                  "kind",
                  "text",
                  "yes",
                  "no",
                  "options"
                ],
                "additionalProperties": false
              }
            },
            "version": {
              "type": "integer",
              "minimum": 1
            },
            "pending": {
              "type": "boolean",
              "description": "A change the server has not acknowledged yet (5)."
            },
            "removing": {
              "type": "boolean",
              "description": "The evaluator waits out its undo window (removal.started)."
            }
          },
          "required": [
            "id",
            "book",
            "name",
            "on",
            "questions",
            "version",
            "pending",
            "removing"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "evaluators"
    ],
    "additionalProperties": false
  },
  "supersededBy": [
    "evaluator.changed",
    "evaluator.deleted"
  ]
}

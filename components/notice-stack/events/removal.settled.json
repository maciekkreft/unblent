{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The undo window ran out, or the user dismissed the notice: the thing is gone.",
  "type": "object",
  "properties": {
    "kind": {
      "enum": [
        "project",
        "rubric",
        "question",
        "option",
        "case",
        "evaluator",
        "choice-point",
        "guest",
        "trial",
        "note",
        "conversation"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^([0-9A-HJKMNP-TV-Z]{26}|[0-9a-f]{32})$",
      "description": "A record's ULID, an account id (32 hex) when kind is guest, or a fixed id when kind is trial (a try page started over)."
    }
  },
  "required": [
    "kind",
    "id"
  ],
  "additionalProperties": false
}

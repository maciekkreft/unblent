{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The user pressed Undo: the thing is back as it was.",
  "type": "object",
  "properties": {
    "kind": {
      "enum": [
        "project",
        "rubric",
        "question",
        "option",
        "case",
        "evaluator",
        "choice-point",
        "guest"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^([0-9A-HJKMNP-TV-Z]{26}|[0-9a-f]{32})$",
      "description": "A record's ULID, or an account id (32 hex) when kind is guest."
    }
  },
  "required": [
    "kind",
    "id"
  ],
  "additionalProperties": false
}
